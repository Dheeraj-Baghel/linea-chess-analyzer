+/* Scores remain explicitly estimated and partial coverage remains prominent. */
+.accuracy-summary { padding: 16px; margin: 16px 0; border: 1px solid var(--border); border-radius: 8px; background: var(--surface-raised); }
+.accuracy-summary.compact { margin: 0 12px 12px; padding: 12px; }
+.accuracy-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
+.accuracy-heading > .eyebrow { display: flex; align-items: center; flex-wrap: wrap; gap: 4px; font-size: 12px; letter-spacing: .025em; }
+.accuracy-heading > .eyebrow > span { padding: 0 4px; border: 1px solid var(--border-control); border-radius: 4px; color: var(--text-secondary); font-size: 12px; font-weight: 400; }
+.accuracy-heading > strong { color: var(--text-primary); font-size: 20px; font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
+.accuracy-heading > strong > small { margin-left: 4px; color: var(--text-secondary); font-size: 12px; font-weight: 400; }
+.player-accuracies { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
+.accuracy-player { min-width: 0; }
+.accuracy-player > div { display: flex; align-items: center; flex-wrap: wrap; gap: 4px; min-width: 0; font-size: 12px; }
+.accuracy-player > div > span { max-width: 100%; overflow: hidden; color: var(--text-secondary); text-overflow: ellipsis; white-space: nowrap; }
+.accuracy-player > div > strong { margin-left: auto; color: var(--text-primary); font-size: 16px; font-weight: 600; font-variant-numeric: tabular-nums; }
+.accuracy-player progress { display: block; width: 100%; height: 4px; margin: 8px 0 4px; border: 0; border-radius: 4px; appearance: none; overflow: hidden; background: var(--border); }
+.accuracy-player progress::-webkit-progress-bar { background: var(--border); }
+.accuracy-player progress::-webkit-progress-value { background: var(--action); border-radius: 4px; transition: width .3s; }
+.accuracy-player progress::-moz-progress-bar { background: var(--action); }
+.accuracy-player > small { display: block; color: var(--text-secondary); font-size: 12px; line-height: 1.7; }
+.accuracy-coverage { margin-top: 12px; color: var(--text-secondary); font-size: 12px; line-height: 1.7; }
+.accuracy-method { padding-top: 8px; margin-top: 12px; border-top: 1px solid var(--border-control); }
+.accuracy-method > summary { min-height: 44px; padding-block: 8px; color: var(--action); font-size: 12px; line-height: 1.7; cursor: pointer; }
+.accuracy-method > p { margin-top: 8px; color: var(--text-secondary); font-size: 14px; line-height: 1.8; }
+.move-coach-metrics { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; padding: 12px 0; margin-top: 12px; border-block: 1px solid var(--border-control); }
+.move-coach-metrics > span { display: flex; flex-direction: column; gap: 4px; color: var(--text-secondary); font-size: 12px; }
+.move-coach-metrics b { color: var(--text-primary); font-size: 14px; font-weight: 600; font-variant-numeric: tabular-nums; }
+.better-continuation { display: flex; align-items: flex-start; flex-direction: column; gap: 8px; margin-top: 12px; }
+.better-continuation > span { color: var(--text-secondary); font-size: 14px; line-height: 1.8; }
+.better-continuation strong { color: var(--text-primary); font-family: var(--font-mono); font-weight: 500; }
+.brilliant-evidence { display: flex; align-items: center; gap: 8px; padding: 12px; margin-top: 12px; border: 1px solid var(--brilliant-border); border-radius: 8px; background: var(--brilliant-surface); color: var(--feedback-brilliant); font-size: 12px; line-height: 1.7; }
+.feedback-brilliant .feedback-icon { border-radius: 4px; background: var(--brilliant-surface); color: var(--feedback-brilliant); }
+.personal-coach { padding-top: 16px; margin-top: 24px; border-top: 1px solid var(--border); }
+.personal-coach > header { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
+.coach-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 36px; height: 36px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface-raised); color: var(--action); }
+.personal-coach > header .eyebrow { font-size: 12px; letter-spacing: .025em; }
+.personal-coach > header h3 { margin-top: 4px; color: var(--text-primary); font-size: 18px; font-weight: 600; line-height: 1.4; }
+.personal-coach > header > select { max-width: 112px; min-height: 44px; padding: 8px; margin-left: auto; border: 1px solid var(--border-control); border-radius: 8px; background: var(--surface-raised); color: var(--text-primary); font-size: 12px; }
+.personal-coach > h4 { margin-top: 16px; color: var(--text-primary); font-size: 16px; font-weight: 600; line-height: 1.7; }
+.personal-coach > p { margin-top: 12px; color: var(--text-secondary); font-size: 14px; line-height: 1.8; }
+.coach-strength > span, .coach-label { display: block; margin-bottom: 4px; color: var(--text-primary); font-size: 12px; font-weight: 600; }
+.coach-drill { display: flex; align-items: flex-start; gap: 8px; padding: 16px; margin-top: 16px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface-raised); color: var(--action); }
+.coach-drill > svg { margin-top: 2px; }
+.coach-drill strong { color: var(--text-primary); font-size: 14px; font-weight: 600; }
+.coach-drill p { margin-top: 8px; color: var(--text-secondary); font-size: 14px; line-height: 1.8; }
+.coach-note { display: block; margin-top: 16px; color: var(--text-secondary); font-size: 12px; line-height: 1.8; }
+.coach-empty > p { margin-top: 12px; color: var(--text-secondary); font-size: 14px; line-height: 1.8; }
+.coach-empty > .button { margin-top: 12px; }
+.critical-moments { margin-top: 24px; }
+.critical-moments > .eyebrow, .brilliant-moments > .eyebrow { font-size: 12px; }
+.critical-moments > div { padding-block: 8px; border-bottom: 1px solid var(--border); }
+.critical-position { display: flex; align-items: center; gap: 8px; width: 100%; min-height: 44px; padding: 8px 0; color: var(--text-secondary); font-size: 12px; text-align: left; }
+.critical-position > span:first-child { min-width: 20px; font-size: 14px; font-weight: 700; text-align: center; }
+.critical-position > strong { color: var(--text-primary); font-family: var(--font-mono); font-size: 14px; font-weight: 500; }
+.critical-position > span:nth-child(3) { margin-left: auto; color: var(--text-secondary); font-size: 12px; }
+.critical-actions { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 4px 8px; padding-left: 24px; }
+.critical-actions > button { display: flex; align-items: center; gap: 4px; min-height: 44px; padding: 8px 4px; border-radius: 8px; color: var(--action); font-size: 12px; text-align: left; }
+.critical-actions > button:hover { background: var(--surface-hover); }
+.brilliant-moments { margin-top: 16px; }
+.brilliant-moments > button { display: flex; align-items: center; gap: 8px; width: 100%; min-height: 44px; padding: 8px 0; color: var(--feedback-brilliant); font-size: 14px; text-align: left; }
+.brilliant-moments > button > span { padding: 2px 6px; border-radius: 4px; background: var(--brilliant-surface); color: var(--feedback-brilliant); font-size: 12px; font-weight: 700; }
+.brilliant-moments > button > svg { margin-left: auto; }
+
+@media (max-width: 600px) {
+  .link-month-field { flex-direction: column; align-items: flex-start; gap: 8px; }
+  .link-month-field > .text-input { width: 100%; }
+  .archive-filters { align-items: stretch; }
+  .archive-filters > label { flex: 1; flex-direction: column; align-items: stretch; gap: 4px; }
+  .archive-filters select { width: 100%; max-width: none; }
+  .archive-results { padding: 12px; }
+  .import-search-row > .button { padding-inline: 12px; }
+}
+@media (max-width: 390px) {
+  .import-search-row { flex-wrap: wrap; }
+  .import-search-row > .text-input { flex-basis: 100%; }
+  .import-search-row > .button { width: 100%; }
+  .archive-game { gap: 8px; }
+  .accuracy-heading { align-items: flex-start; }
+}
