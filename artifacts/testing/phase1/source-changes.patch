+.import-search-row > .text-input { flex: 1; }
+.import-search-row > .button { flex-shrink: 0; }
+.link-month-field { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 12px; }
+.link-month-field > .field-label { margin: 0; line-height: 1.7; }
+.link-month-field > .text-input { width: 176px; font-size: 14px; }
