+.shortcut-list { border-top: 1px solid var(--border); }
+.shortcut-list > div { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 44px; padding: 12px 0; border-bottom: 1px solid var(--border); color: var(--text-secondary); font-size: 14px; }
+.help-callout h3 { margin-top: 24px; font-size: 16px; font-weight: 600; }
