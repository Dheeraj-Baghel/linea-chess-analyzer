+.import-mode-buttons > button.selected { color: var(--action); }
+.import-mode-buttons > button.selected::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--action); }
+.chesscom-import form > .field-label { margin-top: 12px; }
